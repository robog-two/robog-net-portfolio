---
title: Sam's Thoughts.
layout: page.liquid
primaryColor: "#ffc533"
style: blog
---
{%- for post in collections.post reversed -%}
  {%- if post.data.snippet == 'yes' -%}
    <article class="snippet-card">
      <header class="post-header">
        Snippet Post • <time datetime="{{ post.data.date | date: '%Y-%m-%d' }}"
          >{{ post.data.date | date: '%B %d, %Y' }}
          {{ post.data.time -}}
        </time>
      </header>
      {{ post.data.page.rawInput | md }}
    </article>
  {%- else -%}
    <article class="blog-post-card">
        <header class="post-header">
          <h2><a href="{{ post.url }}" class="card-link">{{ post.data.title }}</a></h2>
          <span class="post-time">
            {%- if post.data.live == 'yes' -%}
              Live Blog Started&nbsp;
            {%- endif -%}
            <time datetime="{{ post.data.date | date: '%Y-%m-%d' }}">{{ post.data.date | date: '%B %d, %Y' }}</time>
          </span>
        </header>
        <p class="post-excerpt">{{ post.data.page.rawInput | excerpt }}</p>
        <a href="{{ post.url }}" class="read-more" aria-hidden="true" tabindex="-1">Read More</a>
    </article>
  {%- endif -%}
{%- endfor -%}
